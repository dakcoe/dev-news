# 이 파일을 복사해서 이름을 .env 로 바꾸고 키를 채우세요.
#   copy .env.example .env      (윈도우)
#   cp   .env.example .env      (맥/리눅스)
#
# .env 는 .gitignore에 들어 있어 깃허브에 올라가지 않습니다.

GROQ_API_KEY=gsk_여기에_키를_붙여넣으세요

# 공급자를 바꾸려면 (groq / openrouter / gemini)
# LLM_PROVIDER=groq

# 모델을 직접 지정하려면
# LLM_MODEL=llama-3.3-70b-versatile
